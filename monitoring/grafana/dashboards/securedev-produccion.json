{
  "uid": "securedev-prod",
  "title": "SecureDev - Producción",
  "description": "Monitorización en tiempo real de securedev-prod: disponibilidad, tráfico, errores y eventos de seguridad.",
  "tags": ["securedev", "produccion", "seguridad"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 39,
  "editable": false,
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Estado de la aplicación",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "up{job=\"securedev-prod\"}" }],
      "fieldConfig": { "defaults": {
        "mappings": [{ "type": "value", "options": {
          "0": { "text": "CAÍDA", "color": "red" },
          "1": { "text": "EN LÍNEA", "color": "green" } } }],
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2, "type": "stat", "title": "Intentos de XSS bloqueados (rango)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(increase(app_security_events_total{type=\"xss_attempt\"}[$__range])) or vector(0)" }],
      "fieldConfig": { "defaults": { "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3, "type": "stat", "title": "Rutas inexistentes sondeadas (rango)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(increase(app_security_events_total{type=\"resource_probe\"}[$__range])) or vector(0)" }],
      "fieldConfig": { "defaults": { "decimals": 0,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 5 } ] } } },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 4, "type": "stat", "title": "% respuestas 4xx (último minuto)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "(sum(rate(app_http_requests_total{status=~\"4..\"}[1m])) or vector(0)) / sum(rate(app_http_requests_total[1m]))" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "red", "value": 0.3 } ] } } },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Peticiones por segundo según código HTTP",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (status) (rate(app_http_requests_total[1m]))", "legendFormat": "HTTP {{status}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15 } } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Eventos de seguridad por tipo (por minuto)",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (type) (increase(app_security_events_total[1m]))", "legendFormat": "{{type}}" }],
      "fieldConfig": { "defaults": { "decimals": 0, "custom": { "drawStyle": "bars", "fillOpacity": 60 } } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Latencia p95 por endpoint",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(app_http_request_duration_seconds_bucket[1m])))", "legendFormat": "{{endpoint}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 8, "type": "table", "title": "Alertas de seguridad activas (Prometheus)",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "ALERTS{alertstate=\"firing\"}", "format": "table", "instant": true }],
      "transformations": [{ "id": "organize", "options": {
        "excludeByName": { "Time": true, "Value": true, "__name__": true, "job": true, "instance": true },
        "renameByName": { "alertname": "Alerta", "severity": "Severidad", "alertstate": "Estado" } } }]
    }
  ]
}
